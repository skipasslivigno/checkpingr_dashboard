{
  "name": "@workspace/api-server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "export NODE_ENV=development && pnpm run build && pnpm run start",
    "build": "node ./build.mjs",
    "start": "node --enable-source-maps ./dist/index.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test:email": "esbuild src/routes/email.test.ts --bundle --platform=node --format=cjs --external:pg-native --external:nodemailer --outfile=node_modules/.cache/email-tests.cjs && NODE_ENV=test node --test \"$PWD/node_modules/.cache/email-tests.cjs\"",
    "test:charts": "esbuild src/routes/chart-seasons.test.ts --bundle --platform=node --format=cjs --external:pg-native --outfile=node_modules/.cache/chart-tests.cjs && NODE_ENV=test node --test \"$PWD/node_modules/.cache/chart-tests.cjs\"",
    "test:forecasts": "esbuild src/lib/first-entries-forecast.test.ts src/routes/forecast.test.ts --bundle --platform=node --format=cjs --external:pg-native --outdir=node_modules/.cache/forecast-tests && NODE_ENV=test node --test \"$PWD/node_modules/.cache/forecast-tests/lib/first-entries-forecast.test.js\" \"$PWD/node_modules/.cache/forecast-tests/routes/forecast.test.js\"",
    "analyze:forecasts": "esbuild scripts/forecast-analysis.ts --bundle --platform=node --format=cjs --external:pg-native --outfile=node_modules/.cache/forecast-analysis.cjs && node node_modules/.cache/forecast-analysis.cjs"
  },
  "dependencies": {
    "@workspace/api-zod": "workspace:*",
    "@workspace/db": "workspace:*",
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "drizzle-orm": "catalog:",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "nodemailer": "^10.5.0",
    "pino": "^9.14.0",
    "pino-http": "^10.5.0",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/bcryptjs": "^3.0.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "catalog:",
    "@types/nodemailer": "^8.0.2",
    "esbuild": "0.27.3",
    "esbuild-plugin-pino": "^2.3.3",
    "pino-pretty": "^13.1.3",
    "thread-stream": "3.1.0"
  }
}
